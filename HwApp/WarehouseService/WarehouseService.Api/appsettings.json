{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore.HttpLogging": "Information",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  },
  "ConnectionStrings": {
    "Npgsql": ""
  },
  "Auth": {
    "Url": ""
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "GroupId": "warehouse-service",
    "Topics": [ "products" ],
    "WarehouseStockTopic": "stocks",
    "Acks": "All",
    "EnableIdempotence": true
  }
}
