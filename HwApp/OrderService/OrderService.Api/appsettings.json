{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore.HttpLogging": "Information",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  },
  "Idempotency": {
    "ProcessingLockTtl": "00:00:30",
    "RecordTtl": "24:00:00"
  },
  "ConnectionStrings": {
    "Npgsql": ""
  },
  "Auth": {
    "Url": ""
  },
  "Ms": {
    "Billing": {
      "BaseUrl": "",
      "Timeout": "00:00:10"
    },
    "Warehouse": {
      "BaseUrl": "",
      "Timeout": "00:00:10"
    },
    "Delivery": {
      "BaseUrl": "",
      "Timeout": "00:00:10"
    },
    "Catalog": {
      "BaseUrl": "",
      "Timeout": "00:00:10"
    }
  },
  "Kafka": {
    "BootstrapServers": "",
    "Acks": "All",
    "EnableIdempotence": true
  },
  "OrderSaga": {
    "BatchSize": 10,
    "LockDuration": "00:00:60",
    "PollingInterval": "00:00:50"
  }
}
