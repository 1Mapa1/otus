          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Create delivery slot response is OK\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "const json = pm.response.json();\r",
                  "\r",
                  "pm.test(\"Delivery slot id exists\", function () {\r",
                  "    pm.expect(json.slotId).to.be.a(\"string\").and.not.empty;\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Delivery slot timeFrom exists\", function () {\r",
                  "    pm.expect(json.timeFrom).to.be.a(\"string\").and.not.empty;\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Delivery slot timeTo exists\", function () {\r",
                  "    pm.expect(json.timeTo).to.be.a(\"string\").and.not.empty;\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Delivery slot is available\", function () {\r",
                  "    pm.expect(json.status).to.eql(\"Available\");\r",
                  "});\r",
                  "\r",
                  "pm.environment.set(\"deliverySlotId\", json.slotId);\r",
                  "\r",
                  "console.log(\"Delivery slot created:\");\r",
                  "console.log({\r",
                  "    deliverySlotId: pm.environment.get(\"deliverySlotId\"),\r",
                  "    timeFrom: json.timeFrom,\r",
                  "    timeTo: json.timeTo,\r",
                  "    status: json.status\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const now = new Date();\r",
                  "\r",
                  "const timeFrom = new Date(now.getTime() + 24 * 60 * 60 * 1000);\r",
                  "const timeTo = new Date(now.getTime() + 26 * 60 * 60 * 1000);\r",
                  "\r",
                  "pm.environment.set(\"deliverySlotTimeFrom\", timeFrom.toISOString());\r",
                  "pm.environment.set(\"deliverySlotTimeTo\", timeTo.toISOString());"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
