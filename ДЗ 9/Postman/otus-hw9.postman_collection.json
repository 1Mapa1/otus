  "item": [
    {
      "name": "00 Start",
      "item": [
        {
          "name": "Init data",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const suffix = `${Date.now()}_${Math.floor(Math.random() * 100000)}`;\r",
                  "\r",
                  "pm.environment.set(\"suffix\", suffix);\r",
                  "\r",
                  "// User\r",
                  "pm.environment.set(\"userLogin\", `user_${suffix}`);\r",
                  "pm.environment.set(\"userPassword\", `Pass_${suffix}`);\r",
                  "pm.environment.set(\"userName\", `User ${suffix}`);\r",
                  "pm.environment.set(\"userEmail\", `${suffix}@test.com`);\r",
                  "\r",
                  "// Product\r",
                  "pm.environment.set(\"productName\", `Idempotency Product ${suffix}`);\r",
                  "pm.environment.set(\"productPrice\", \"100\");\r",
                  "pm.environment.set(\"productStock\", \"10\");\r",
                  "\r",
                  "// Order\r",
                  "pm.environment.set(\"orderQuantity\", \"2\");\r",
                  "pm.environment.set(\"changedOrderQuantity\", \"3\");\r",
                  "\r",
                  "// Idempotency\r",
                  "pm.environment.set(\"idempotencyKey\", pm.variables.replaceIn(\"{{$guid}}\"));\r",
                  "\r",
                  "// Cleanup runtime values\r",
                  "pm.environment.unset(\"userToken\");\r",
                  "pm.environment.unset(\"productId\");\r",
                  "pm.environment.unset(\"deliverySlotId\");\r",
                  "pm.environment.unset(\"firstOrderId\");\r",
                  "\r",
                  "console.log(\"HW9 idempotency test data initialized:\");\r",
                  "console.log({\r",
                  "    baseUrl: pm.environment.get(\"baseUrl\"),\r",
                  "    suffix,\r",
                  "    userLogin: pm.environment.get(\"userLogin\"),\r",
                  "    userEmail: pm.environment.get(\"userEmail\"),\r",
                  "    productName: pm.environment.get(\"productName\"),\r",
                  "    idempotencyKey: pm.environment.get(\"idempotencyKey\")\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Health check endpoint is reachable or intentionally absent\", function () {\r",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 204, 404]);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Base URL uses arch.homework\", function () {\r",
                  "    pm.expect(pm.environment.get(\"baseUrl\")).to.include(\"arch.homework\");\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Random test data initialized\", function () {\r",
                  "    pm.expect(pm.environment.get(\"suffix\")).to.exist;\r",
                  "    pm.expect(pm.environment.get(\"userLogin\")).to.exist;\r",
                  "    pm.expect(pm.environment.get(\"userPassword\")).to.exist;\r",
                  "    pm.expect(pm.environment.get(\"userEmail\")).to.exist;\r",
                  "    pm.expect(pm.environment.get(\"productName\")).to.exist;\r",
                  "    pm.expect(pm.environment.get(\"idempotencyKey\")).to.exist;\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Order quantities initialized\", function () {\r",
                  "    pm.expect(Number(pm.environment.get(\"orderQuantity\"))).to.eql(2);\r",
                  "    pm.expect(Number(pm.environment.get(\"changedOrderQuantity\"))).to.eql(3);\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health/live",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health",
                "live"
              ]
            }
          },
          "response": []
        }
      ]
