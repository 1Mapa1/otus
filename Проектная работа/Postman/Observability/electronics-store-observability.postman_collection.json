{
  "info": {
    "_postman_id": "af5b0229-3390-43ca-a048-7afb63ee1f7a",
    "name": "Electronics Store — Grafana and ELK demo",
    "description": "Short Auth + Customer scenario for generating HTTP metrics and correlated structured logs.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "var obsIterationValue=String(pm.info.iteration);",
          "if(pm.environment.get('demoIteration')!==obsIterationValue){",
          "  var obsUniqueSuffix=Date.now()+'-'+obsIterationValue+'-'+Math.floor(Math.random()*100000);",
          "  pm.environment.set('demoIteration',obsIterationValue);",
          "  pm.environment.set('demoSuffix',obsUniqueSuffix);",
          "  pm.environment.set('userLogin','obs_'+obsUniqueSuffix);",
          "  pm.environment.set('userPassword','Obs_'+obsUniqueSuffix+'!');",
          "  pm.environment.set('userEmail','obs_'+obsUniqueSuffix+'@example.test');",
          "  pm.environment.unset('userToken');",
          "  pm.environment.unset('addressId');",
          "}",
          "pm.environment.set('requestId','observability-'+pm.variables.replaceIn('{{$guid}}'));"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('X-Request-ID is returned',()=>pm.expect(pm.response.headers.get('X-Request-ID')).to.eql(pm.environment.get('requestId')));",
          "console.log('Kibana RequestId ['+pm.info.requestName+']: '+pm.environment.get('requestId'));"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 Register user — Auth calls Customer with same Request ID",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-Request-ID", "value": "{{requestId}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"login\": \"{{userLogin}}\",\n  \"password\": \"{{userPassword}}\",\n  \"name\": \"Observability User {{demoSuffix}}\",\n  \"email\": \"{{userEmail}}\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/api/auth/register"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('User registered',()=>pm.response.to.have.status(201));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Login user",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-Request-ID", "value": "{{requestId}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{ \"login\": \"{{userLogin}}\", \"password\": \"{{userPassword}}\" }",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/api/auth/login"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Login succeeded',()=>pm.response.to.have.status(200));",
              "const body=pm.response.json();pm.expect(body.accessToken).to.be.a('string').and.not.empty;pm.environment.set('userToken',body.accessToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Get customer profile",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{userToken}}", "type": "string" }]
        },
        "method": "GET",
        "header": [{ "key": "X-Request-ID", "value": "{{requestId}}" }],
        "url": "{{baseUrl}}/api/customers/me"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Customer profile returned',()=>pm.response.to.have.status(200));",
              "pm.test('Correct email returned',()=>pm.expect(pm.response.json().email).to.eql(pm.environment.get('userEmail')));"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Update customer profile",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{userToken}}", "type": "string" }]
        },
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-Request-ID", "value": "{{requestId}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{ \"name\": \"Observability User Updated\", \"email\": \"{{userEmail}}\", \"dateOfBirth\": \"1995-05-15T00:00:00Z\" }",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/api/customers/me"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.test('Profile updated',()=>pm.response.to.have.status(204));"]
          }
        }
      ]
    },
    {
      "name": "05 Create customer address",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{userToken}}", "type": "string" }]
        },
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-Request-ID", "value": "{{requestId}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{ \"city\": \"Moscow\", \"street\": \"Observability Street\", \"house\": 10, \"apartment\": 25 }",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/api/customers/me/addresses"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Address created',()=>pm.response.to.have.status(201));",
              "const body=pm.response.json();pm.expect(body.id).to.be.a('string');pm.environment.set('addressId',body.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "06 Get customer addresses",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{userToken}}", "type": "string" }]
        },
        "method": "GET",
        "header": [{ "key": "X-Request-ID", "value": "{{requestId}}" }],
        "url": "{{baseUrl}}/api/customers/me/addresses"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Addresses returned',()=>pm.response.to.have.status(200));",
              "pm.test('Created address is present',()=>pm.expect(pm.response.json().some(x=>x.id===pm.environment.get('addressId'))).to.be.true);"
            ]
          }
        }
      ]
    },
    {
      "name": "07 Update customer address",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{userToken}}", "type": "string" }]
        },
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-Request-ID", "value": "{{requestId}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{ \"city\": \"Moscow\", \"street\": \"Observability Street Updated\", \"house\": 10, \"apartment\": 26 }",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/api/customers/me/addresses/{{addressId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.test('Address updated',()=>pm.response.to.have.status(204));"]
          }
        }
      ]
    },
    {
      "name": "08 Expected 500 — application error for Kibana",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-Request-ID", "value": "{{requestId}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{ \"login\": \"{{userLogin}}\", \"password\": \"DefinitelyWrongPassword!\" }",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/api/auth/login"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.test('Application error is generated for Kibana',()=>pm.response.to.have.status(500));"]
          }
        }
      ]
    },
    {
      "name": "09 Expected 401 — profile without token",
      "request": {
        "auth": { "type": "noauth" },
        "method": "GET",
        "header": [{ "key": "X-Request-ID", "value": "{{requestId}}" }],
        "url": "{{baseUrl}}/api/customers/me"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.test('Anonymous request rejected',()=>pm.response.to.have.status(401));"]
          }
        }
      ]
    },
    {
      "name": "10 Expected 404 — missing address",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{userToken}}", "type": "string" }]
        },
        "method": "DELETE",
        "header": [{ "key": "X-Request-ID", "value": "{{requestId}}" }],
        "url": "{{baseUrl}}/api/customers/me/addresses/00000000-0000-0000-0000-000000000001"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.test('Missing address returns 404',()=>pm.response.to.have.status(404));"]
          }
        }
      ]
    },
    {
      "name": "11 Delete created address",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{userToken}}", "type": "string" }]
        },
        "method": "DELETE",
        "header": [{ "key": "X-Request-ID", "value": "{{requestId}}" }],
        "url": "{{baseUrl}}/api/customers/me/addresses/{{addressId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.test('Address deleted',()=>pm.response.to.have.status(204));"]
          }
        }
      ]
    }
  ]
}
