      "targets": [
        {
          "expr": "sum by (datname) (rate(pg_stat_database_xact_commit{namespace=\"electronics-store\",datname=~\"$database\"}[5m]) + rate(pg_stat_database_xact_rollback{namespace=\"electronics-store\",datname=~\"$database\"}[5m]))",
          "legendFormat": "{{datname}}",
          "refId": "A"
        }
      ],
      "title": "Database transactions per second",
      "type": "timeseries"
