        "legend": {"calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "expr": "100 * sum by (datname) (rate(pg_stat_database_blks_hit{namespace=\"electronics-store\",datname=~\"$database\"}[5m])) / clamp_min(sum by (datname) (rate(pg_stat_database_blks_hit{namespace=\"electronics-store\",datname=~\"$database\"}[5m]) + rate(pg_stat_database_blks_read{namespace=\"electronics-store\",datname=~\"$database\"}[5m])), 0.000001)",
          "legendFormat": "{{datname}}",
          "refId": "A"
        }
      ],
